@* Teléfono y dirección salen de la base y se editan en /Admin/Settings. *@
@inject AestheticCenter.Web.SiteSettingsProvider Sitio
@inject AestheticCenter.Web.CatalogoServicios Catalogo
@{
    // Dominio público del sitio. Si se migra a un dominio propio, actualizar también
    // wwwroot/robots.txt y wwwroot/sitemap.xml, que lo llevan escrito.
    var siteUrl = SiteInfo.Url;

    var canonicalUrl = siteUrl + Context.Request.Path.Value?.TrimEnd('/');
    if (canonicalUrl == siteUrl) { canonicalUrl = siteUrl + "/"; }

    var metaDescription = ViewData["Description"] as string
        ?? "Pati C Estética & Cosmetología en Montevideo. Tratamientos faciales, masajes y cuidado personal personalizado. Reservá tu turno online.";
    var pageTitle = $"{ViewData["Title"]} - Pati C Estética";
}
<!DOCTYPE html>
<html lang="es-UY">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="@metaDescription" />
    <meta name="google-site-verification" content="-Y4Rtxe_bKWeNlVp8Bkm6zeU0L6n5HPRsz_bAVE0OjE" />
    <meta name="author" content="Pati C Estética" />
    <link rel="canonical" href="@canonicalUrl" />
    @if (ViewData["Robots"] is string robots)
    {
        <meta name="robots" content="@robots" />
    }
    <title>@pageTitle</title>

    @* Iconos del sitio, generados a partir de images/logo-patic.png. Google toma
       /favicon.ico (o el rel="icon" de mayor tamaño) para el resultado de búsqueda,
       y exige que sea cuadrado y de al menos 48px. *@
    <link rel="icon" href="~/favicon.ico" sizes="any" />
    <link rel="icon" type="image/png" sizes="48x48" href="~/favicon-48x48.png" asp-append-version="true" />
    <link rel="icon" type="image/png" sizes="96x96" href="~/favicon-96x96.png" asp-append-version="true" />
    <link rel="apple-touch-icon" sizes="180x180" href="~/apple-touch-icon.png" asp-append-version="true" />
    @* .json en lugar de .webmanifest: MapStaticAssets resuelve el content-type por
       extension y no conoce .webmanifest. *@
    <link rel="manifest" href="~/manifest.json" />
    <meta name="theme-color" content="#fdf6f0" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Pati C Estética" />
    <meta property="og:locale" content="es_UY" />
    <meta property="og:title" content="@pageTitle" />
    <meta property="og:description" content="@metaDescription" />
    <meta property="og:url" content="@canonicalUrl" />
    <meta property="og:image" content="@(siteUrl)/images/logo-patic.jpg" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="@pageTitle" />
    <meta name="twitter:description" content="@metaDescription" />
    <meta name="twitter:image" content="@(siteUrl)/images/logo-patic.jpg" />

    @* Datos estructurados de negocio local: es lo que permite a Google mostrar el
       negocio en resultados locales y en Maps. Los datos salen de SiteInfo. *@
    @* El prefijo "!" desactiva los tag helpers en este elemento: de lo contrario
       ScriptTagHelper reescribe el atributo y el "+" sale codificado como &#x2B;. *@
    <!script type="application/ld+json">
    {
      "@@context": "https://schema.org",
      "@@type": "BeautySalon",
      "name": "Pati C Estética & Cosmetología",
      "alternateName": "Pati C Estética",
      "description": "@Html.Raw(JsonLd.Texto(metaDescription))",
      "url": "@siteUrl",
      "image": "@(siteUrl)/images/logo-patic.jpg",
      "logo": "@(siteUrl)/icon-512.png",
      "telephone": "@Html.Raw(JsonLd.Texto(Sitio.Telefono))",
      "priceRange": "$$",
      "currenciesAccepted": "UYU",
      "address": {
        "@@type": "PostalAddress",
@if (Sitio.TieneDireccion)
{
        @:"streetAddress": "@Html.Raw(JsonLd.Texto(Sitio.Direccion))",
}
        "addressLocality": "@SiteInfo.Ciudad",
        "addressRegion": "@SiteInfo.Ciudad",
        "postalCode": "@SiteInfo.CodigoPostal",
        "addressCountry": "UY"
      },
      "areaServed": [
        { "@@type": "City", "name": "@SiteInfo.Ciudad" },
        { "@@type": "Place", "name": "@SiteInfo.Barrio, @SiteInfo.Ciudad" }
      ],
@if (SiteInfo.TieneHorarios)
{
      @:"openingHoursSpecification": {
        @:"@@type": "OpeningHoursSpecification",
        @:"dayOfWeek": [@Html.Raw(SiteInfo.DiasAtencionJson)],
        @:"opens": "@SiteInfo.HoraApertura",
        @:"closes": "@SiteInfo.HoraCierre"
      @:},
}
      "knowsAbout": [
        "Estética",
        "Cosmetología",
        "Tratamientos faciales",
        "Masajes estéticos",
        "Cuidado de la piel"
      ],
      @* El catálogo sale de los servicios cargados en el panel: escrito a mano
         acá quedaba desfasado de los que realmente se ofrecen. *@
      "hasOfferCatalog": {
        "@@type": "OfferCatalog",
        "name": "Servicios de estética y cosmetología",
        "itemListElement": [
          @Html.Raw(Catalogo.OfertasJson())
        ]
      },
      "founder": {
        "@@type": "Person",
        "name": "Patricia",
        "jobTitle": "Esteticista y Cosmetóloga"
      },
      "sameAs": [
        "https://instagram.com/pati.c.estetica"
      ]
    }
    </!script>
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,500;1,400&family=Inter:wght@300;400;500&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
    <link rel="stylesheet" href="~/css/site.css?v=2" asp-append-version="true" />
    <link rel="stylesheet" href="~/AestheticCenter.Web.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg navbar-light bg-nude border-bottom sticky-top py-3">
            <div class="container">
                <a class="navbar-brand d-flex align-items-center gap-2" asp-area="" asp-page="/Index">
                    <img src="~/images/logo-icon.png" alt="Logo Pati C" width="48" height="48" class="rounded-circle shadow-sm" asp-append-version="true" />
                    <div>
                        <div class="nav-brand">Pati C</div>
                        <div class="nav-sub">Estética · Cosmetología</div>
                    </div>
                </a>
                <button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1 justify-content-center">
                        <li class="nav-item">
                            <a class="nav-link" asp-page="/Index">Inicio</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-page="/Services/Index">Servicios</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-page="/Gallery/Index">Galería</a>
                        </li>
                        @if (User.IsInRole("Admin"))
                        {
                            <li class="nav-item">
                                <a class="nav-link text-primary fw-bold" asp-page="/Admin/Appointments">Citas Admin</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-primary fw-bold" asp-page="/Admin/Services/Index">Servicios Admin</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-primary fw-bold" asp-page="/Admin/Settings">Configuración</a>
                            </li>
                        }
                    </ul>
                    <partial name="_LoginPartial" />
                    <a href="@Sitio.WhatsApp" target="_blank" class="nav-cta ms-lg-3 mt-3 mt-lg-0 text-center text-decoration-none">Reservar turno</a>
                </div>
            </div>
        </nav>
    </header>
    <div class="main-wrapper">
        <main role="main">
            @RenderBody()
        </main>
    </div>

    <footer class="footer-dark py-5">
        <div class="container">
            <div class="row align-items-center">
                <div class="col-md-6 text-center text-md-start mb-3 mb-md-0">
                    <span>© 2026 · Pati C Estética & Cosmetología · Montevideo</span>
                </div>
                <div class="col-md-6 text-center text-md-end footer-links">
                    <a href="https://instagram.com/pati.c.estetica" target="_blank" class="me-3">Instagram</a>
                    <a asp-page="/Privacy" class="me-3">Privacidad</a>
                    <a href="mailto:info@aestheticcenter.com">Contacto</a>
                </div>
            </div>
        </div>
    </footer>

    <a href="@Sitio.WhatsAppCon("Hola Patricia, quiero consultar sobre los servicios")"
       target="_blank" class="wa-float shadow" title="Escribir por WhatsApp">
        <i class="bi bi-whatsapp"></i>
    </a>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
