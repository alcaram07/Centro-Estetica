@using Microsoft.AspNetCore.Identity
@inject SignInManager<IdentityUser> SignInManager
@inject UserManager<IdentityUser> UserManager

<ul class="navbar-nav align-items-lg-center">
@if (SignInManager.IsSignedIn(User))
{
    @* Solo la parte anterior a la arroba: el correo entero ocupaba media barra. *@
    var correo = User.Identity?.Name ?? "";
    var arroba = correo.IndexOf('@');
    var nombre = arroba > 0 ? correo[..arroba] : correo;

    <li class="nav-item dropdown">
        <a class="nav-link dropdown-toggle" href="#" role="button"
           data-bs-toggle="dropdown" aria-expanded="false" title="@correo">
            <i class="bi bi-person-circle"></i> @nombre
        </a>
        <ul class="dropdown-menu dropdown-menu-end nav-panel-menu">
            <li>
                <a class="dropdown-item" asp-area="Identity" asp-page="/Account/Manage/Index">
                    <i class="bi bi-person"></i> Mi cuenta
                </a>
            </li>
            <li><hr class="dropdown-divider" /></li>
            <li>
                @* Identity exige POST para cerrar sesión, así que el ítem del
                   menú tiene que seguir siendo un formulario. *@
                <form asp-area="Identity" asp-page="/Account/Logout"
                      asp-route-returnUrl="@Url.Page("/", new { area = "" })" method="post">
                    <button type="submit" class="dropdown-item">
                        <i class="bi bi-box-arrow-right"></i> Cerrar sesión
                    </button>
                </form>
            </li>
        </ul>
    </li>
}
else
{
    <li class="nav-item">
        <a class="nav-link" asp-area="Identity" asp-page="/Account/Register">Registrarse</a>
    </li>
    <li class="nav-item">
        <a class="nav-link" asp-area="Identity" asp-page="/Account/Login">Iniciar sesión</a>
    </li>
}
</ul>
