@page "{id:int}"
@model AestheticCenter.Web.Pages.Admin.Services.EditModel
@{
    ViewData["Title"] = "Editar Servicio";
}

<div class="row justify-content-center">
    <div class="col-md-8">
        <div class="card shadow-sm border-0">
            <div class="card-header admin-card-header py-3">
                <h2 class="mb-0 fs-4">Editar Servicio</h2>
            </div>
            <div class="card-body p-4">
                <form method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                    <input type="hidden" asp-for="Service.Id" />
                    
                    <div class="mb-3">
                        <label asp-for="Service.Name" class="form-label">Nombre del Servicio</label>
                        <input asp-for="Service.Name" class="form-control" />
                        <span asp-validation-for="Service.Name" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Service.Description" class="form-label">Descripción</label>
                        <textarea asp-for="Service.Description" class="form-control" rows="3"></textarea>
                        <span asp-validation-for="Service.Description" class="text-danger"></span>
                        <div class="form-text">Una frase, para la tarjeta del listado.</div>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Service.LongDescription" class="form-label">Texto de la página del tratamiento</label>
                        <textarea asp-for="Service.LongDescription" class="form-control" rows="8"
                                  placeholder="Qué incluye, cuánto dura, para qué tipo de piel, qué esperar después..."></textarea>
                        <span asp-validation-for="Service.LongDescription" class="text-danger"></span>
                        <div class="form-text">
                            Este texto se publica como página propia del tratamiento y es lo que
                            hace que Google lo encuentre por su nombre. Separá los párrafos con
                            una línea en blanco.
                            <br />
                            Mientras esté vacío, la página existe pero se le pide a Google que no
                            la muestre: una página de dos líneas no posiciona.
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="Service.Price" class="form-label">Precio ($)</label>
                            <input asp-for="Service.Price" class="form-control" type="number" step="0.01" />
                            <span asp-validation-for="Service.Price" class="text-danger"></span>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="Service.DurationMinutes" class="form-label">Duración (minutos)</label>
                            <input asp-for="Service.DurationMinutes" class="form-control" type="number" />
                            <span asp-validation-for="Service.DurationMinutes" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="d-grid gap-2 mt-4">
                        <button type="submit" class="btn btn-primary btn-lg">Guardar Cambios</button>
                        <a asp-page="./Index" class="btn btn-outline-secondary">Cancelar</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
