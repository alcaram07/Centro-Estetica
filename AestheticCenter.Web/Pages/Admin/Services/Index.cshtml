@page
@model AestheticCenter.Web.Pages.Admin.Services.IndexModel
@{
    ViewData["Title"] = "Gestión de Servicios";
}

@* En el celular el encabezado se apila: en una sola fila el botón apretaba el
   título hasta partirlo. *@
<div class="d-flex flex-column flex-sm-row justify-content-between align-items-start align-items-sm-center gap-3 mb-4">
    <div>
        <h1 class="admin-title">Gestión de servicios</h1>
        <p class="admin-sub">Añadí o modificá los tratamientos que ofrecés.</p>
    </div>
    <a asp-page="./Create" class="btn btn-primary btn-sm flex-shrink-0">
        <i class="bi bi-plus-lg"></i> Nuevo servicio
    </a>
</div>

<div class="card shadow-sm border-0">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                @* La descripción y la duración se ocultan en pantallas chicas:
                   con cinco columnas la tabla obligaba a desplazarse. *@
                <tr>
                    <th>Nombre</th>
                    <th class="d-none d-lg-table-cell">Descripción</th>
                    <th>Precio</th>
                    <th class="d-none d-md-table-cell">Duración</th>
                    <th class="text-end">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var service in Model.Services)
                {
                    <tr>
                        <td>
                            <div class="fw-bold">@service.Name</div>
                            @* En pantallas chicas, donde la columna de duración
                               está oculta, el dato viaja acá. *@
                            <small class="text-muted d-md-none">@service.DurationMinutes min</small>
                        </td>
                        <td class="text-muted small d-none d-lg-table-cell">@service.Description</td>
                        <td>@SiteInfo.FormatoPrecio(service.Price)</td>
                        <td class="d-none d-md-table-cell">@service.DurationMinutes min</td>
                        <td class="text-end admin-acciones">
                            <div class="btn-group btn-group-sm">
                                <a asp-page="./Edit" asp-route-id="@service.Id" class="btn btn-outline-secondary" title="Editar">
                                    <i class="bi bi-pencil"></i>
                                </a>
                                <a asp-page="./Delete" asp-route-id="@service.Id" class="btn btn-outline-danger" title="Eliminar">
                                    <i class="bi bi-trash"></i>
                                </a>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
