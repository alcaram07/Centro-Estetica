@page
@model AestheticCenter.Web.Pages.Admin.AppointmentsModel
@{
    ViewData["Title"] = "Gestión de Citas";
}

<div class="mb-4">
    <h1 class="admin-title">Citas</h1>
    <p class="admin-sub">Gestioná las reservas de tus clientas.</p>
</div>

@if (!Model.Appointments.Any())
{
    @* Sin esto quedaban los encabezados de la tabla sin ninguna fila debajo. *@
    <div class="card shadow-sm border-0">
        <div class="card-body text-center text-muted py-5">
            <i class="bi bi-calendar-x fs-1 d-block mb-3 opacity-50"></i>
            Todavía no hay citas reservadas.
        </div>
    </div>
}
else
{
<div class="card shadow-sm border-0">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                @* El estado se oculta en pantallas chicas: el mismo badge se
                   repite dentro de la primera celda. *@
                <tr>
                    <th>Cliente</th>
                    <th class="d-none d-lg-table-cell">Servicio</th>
                    <th>Fecha y hora</th>
                    <th class="d-none d-md-table-cell">Estado</th>
                    <th class="text-end">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var appointment in Model.Appointments)
                {
                    @* El estilo del badge se resuelve una vez porque se muestra
                       en dos lugares: en su columna y, en pantallas chicas donde
                       esa columna no está, dentro de la celda del cliente. *@
                    var (badgeClase, badgeTexto) = appointment.Status switch
                    {
                        AestheticCenter.Core.Entities.AppointmentStatus.Pending => ("bg-warning text-dark", "Pendiente"),
                        AestheticCenter.Core.Entities.AppointmentStatus.Confirmed => ("bg-success", "Confirmada"),
                        AestheticCenter.Core.Entities.AppointmentStatus.Cancelled => ("bg-danger", "Cancelada"),
                        AestheticCenter.Core.Entities.AppointmentStatus.Completed => ("bg-info text-dark", "Completada"),
                        _ => ("bg-secondary", appointment.Status.ToString()),
                    };

                    <tr>
                        <td>
                            <div class="fw-bold">@appointment.CustomerId</div>
                            @if (!string.IsNullOrWhiteSpace(appointment.Notes))
                            {
                                <small class="text-muted d-block">@appointment.Notes</small>
                            }
                            <small class="text-muted d-lg-none d-block">@appointment.Service?.Name</small>
                            <span class="badge @badgeClase d-md-none mt-1">@badgeTexto</span>
                        </td>
                        <td class="d-none d-lg-table-cell">@appointment.Service?.Name</td>
                        <td>@appointment.AppointmentTime.ToString("dd/MM/yyyy HH:mm")</td>
                        <td class="d-none d-md-table-cell">
                            <span class="badge @badgeClase">@badgeTexto</span>
                        </td>
                        <td class="text-end admin-acciones">
                            @* d-flex y no btn-group: los hijos son formularios,
                               no botones, y el agrupado salía partido. *@
                            <div class="d-flex gap-1 justify-content-end btn-group-sm">
                                <form method="post" asp-page-handler="UpdateStatus" asp-route-id="@appointment.Id" asp-route-status="Confirmed">
                                    <button type="submit" class="btn btn-outline-success" title="Confirmar">
                                        <i class="bi bi-check-lg"></i>
                                    </button>
                                </form>
                                <form method="post" asp-page-handler="UpdateStatus" asp-route-id="@appointment.Id" asp-route-status="Completed">
                                    <button type="submit" class="btn btn-outline-info" title="Completar">
                                        <i class="bi bi-flag-fill"></i>
                                    </button>
                                </form>
                                <form method="post" asp-page-handler="UpdateStatus" asp-route-id="@appointment.Id" asp-route-status="Cancelled">
                                    <button type="submit" class="btn btn-outline-danger" title="Cancelar">
                                        <i class="bi bi-x-lg"></i>
                                    </button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
}
